{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Stable error codes for Workflow Runtime HTTP endpoints",
  "stable_codes": {
    "400": {
      "unknown_field": "request contains an unknown field",
      "invalid_json": "request body is not valid for this endpoint",
      "missing_idempotency_key": "Idempotency-Key header is required",
      "invalid_idempotency_key": "Idempotency-Key must be 1-128 visible ASCII characters",
      "invalid_path_parameter": "workflowInstanceId must be a UUID"
    },
    "401": {
      "unauthorized": "Missing or invalid authentication token"
    },
    "403": {
      "forbidden": "required scope is missing",
      "principal_disabled": "principal is disabled",
      "domain_disabled": "domain is disabled",
      "domain_membership_required": "active domain membership is required",
      "cross_domain_violation": "definition version does not belong to the domain",
      "principal_not_assignee": "principal is not the current assignee"
    },
    "404": {
      "route_not_found": "route not found",
      "principal_not_found": "principal not found",
      "domain_not_found": "domain not found",
      "definition_version_not_found": "definition version not found",
      "instance_not_found": "workflow instance not found",
      "workflow_instance_not_found_or_not_visible": "workflow instance not found or not visible"
    },
    "409": {
      "idempotency_conflict": "idempotency key was reused",
      "version_not_published": "definition version is not published",
      "source_node_terminal": "terminal nodes cannot transition",
      "workflow_state_version_conflict": "workflow state version does not match",
      "transition_not_applicable": "transition is not applicable"
    },
    "413": {
      "size_limit_exceeded": "request field exceeds its size limit"
    },
    "422": {
      "unprocessable_entity": "pagination parameters are invalid",
      "invalid_cursor": "beforeCreatedAt/beforeId pair is invalid",
      "invalid_lifecycle": "lifecycle must be 'active', 'terminal', or 'all'",
      "invalid_pagination": "pagination parameters are invalid",
      "context_validation_failed": "context payload failed validation",
      "assignee_resolution_failed": "initial/target assignee could not be resolved",
      "submission_required": "submission payload is required",
      "submission_validation_failed": "submission payload failed validation",
      "invalid_input": "invalid request input",
      "invalid_return_references": "return references are invalid"
    },
    "425": {
      "command_still_processing": "command is still processing"
    },
    "500": {
      "internal_consistency_error": "internal consistency error",
      "internal_error": "internal service error"
    },
    "503": {
      "service_unavailable": "storage is unavailable",
      "migration_version_mismatch": "database migration version mismatch"
    },
    "504": {
      "request_timeout": "request timed out"
    }
  },
  "error_envelope": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "details": {
            "type": "object",
            "description": "Optional error details, omitted when empty"
          }
        },
        "required": ["code", "message"]
      }
    },
    "required": ["error"]
  }
}
