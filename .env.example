# PostgreSQL connection URL for svc-workflow
# Default: postgres://postgres:postgres@localhost:5432/svc_workflow
DATABASE_URL=postgres://postgres:postgres@localhost:5432/svc_workflow

# Auth V1 (RS256/JWKS) — required
# Legacy HS256/test_hs256 mode has been removed.
WORKFLOW_JWKS_URL=http://localhost:8080/.well-known/jwks.json
WORKFLOW_JWT_ISSUER=auth-service
WORKFLOW_JWT_AUDIENCE=svc-workflow

# Optional auth V1 feature flags (default-off)
# AUTH_V1_CANARY_ENABLED=true
# AUTH_V1_CANARY_WRITE_ENABLED=true
# AUTH_V1_CANARY_ALLOWED_CLIENT_ID=my-client
# AUTH_V1_CANARY_ALLOWED_SUB=00000000-0000-0000-0000-000000000001

# JWKS cache (optional)
# WORKFLOW_JWKS_CACHE_TTL=300
# WORKFLOW_JWKS_HTTP_TIMEOUT=5
# WORKFLOW_JWKS_MAX_STALE=600
# WORKFLOW_JWT_CLOCK_SKEW=60

# Server bind (optional)
# WORKFLOW_BIND_ADDR=127.0.0.1
# WORKFLOW_PORT=8989
