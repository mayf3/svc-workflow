{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mayf3:agent-development-governance:spec-frontmatter:v0",
  "title": "Governing Spec frontmatter V0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "spec_id",
    "status",
    "spec_kind",
    "authority_level",
    "implementation_authority",
    "scope",
    "governed_by",
    "external_authorities",
    "supersedes",
    "superseded_by",
    "owners"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+$"
    },
    "status": {
      "enum": ["proposed", "accepted", "superseded"]
    },
    "spec_kind": {
      "enum": ["invariant", "program", "implementation"]
    },
    "authority_level": {
      "const": "governing_spec"
    },
    "implementation_authority": {
      "enum": ["none", "contracts"]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "governed_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+$"
      },
      "uniqueItems": true
    },
    "external_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "authority_id", "revision", "relation"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "authority_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "relation": {
            "enum": ["depends_on", "constrained_by", "interoperates_with"]
          }
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+$"
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+$"
        }
      ]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
