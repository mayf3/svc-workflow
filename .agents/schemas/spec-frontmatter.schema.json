{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mayf3:agent-development-governance:spec-frontmatter:v0",
  "title": "Governing Spec frontmatter V0",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "strictSpecId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+$"
    },
    "legacyHistoricalSpecId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+_[A-Z][A-Z0-9_]*$",
      "not": {
        "pattern": "^[A-Z][A-Z0-9_]*_V[0-9]+$"
      }
    }
  },
  "required": [
    "spec_id",
    "status",
    "spec_kind",
    "authority_level",
    "implementation_authority",
    "scope",
    "governed_by",
    "external_authorities",
    "supersedes",
    "superseded_by",
    "owners"
  ],
  "properties": {
    "spec_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded"
      ]
    },
    "spec_kind": {
      "enum": [
        "invariant",
        "program",
        "implementation"
      ]
    },
    "authority_level": {
      "const": "governing_spec"
    },
    "implementation_authority": {
      "enum": [
        "none",
        "contracts"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "governed_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strictSpecId"
      },
      "uniqueItems": true
    },
    "external_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "authority_id",
          "revision",
          "relation"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "authority_id": {
            "$ref": "#/$defs/strictSpecId"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "relation": {
            "enum": [
              "depends_on",
              "constrained_by",
              "interoperates_with"
            ]
          }
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/strictSpecId"
          },
          {
            "$ref": "#/$defs/legacyHistoricalSpecId"
          }
        ]
      },
      "uniqueItems": true,
      "description": "Whole-authority predecessor IDs. On a proposed successor these entries declare non-active replacement intent; predecessors remain accepted and unbacklinked until atomic acceptance."
    },
    "superseded_by": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/strictSpecId"
        }
      ]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "spec_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/strictSpecId"
              },
              {
                "$ref": "#/$defs/legacyHistoricalSpecId"
              }
            ]
          },
          "superseded_by": {
            "$ref": "#/$defs/strictSpecId"
          }
        }
      },
      "else": {
        "properties": {
          "spec_id": {
            "$ref": "#/$defs/strictSpecId"
          },
          "superseded_by": {
            "type": "null"
          }
        }
      }
    }
  ]
}
