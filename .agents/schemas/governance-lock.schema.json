{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mayf3:agent-development-governance:governance-lock:v0",
  "title": "Vendored governance lock V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "distribution",
    "version",
    "source_repository",
    "source_commit",
    "distribution_manifest_sha256",
    "adoption",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "distribution": {"const": "development-governance-v0"},
    "version": {"type": "string", "minLength": 1},
    "source_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "distribution_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "prepared_by",
        "prepared_at",
        "accepted_by",
        "accepted_at"
      ],
      "properties": {
        "mode": {"const": "vendored"},
        "status": {"enum": ["proposed", "accepted"]},
        "prepared_by": {"type": "string", "minLength": 1},
        "prepared_at": {"type": "string", "format": "date-time"},
        "accepted_by": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "accepted_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "proposed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "accepted_by": {"type": "null"},
              "accepted_at": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "accepted"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "accepted_by": {"type": "string", "minLength": 1},
              "accepted_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
