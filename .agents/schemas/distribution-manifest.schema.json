{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mayf3:agent-development-governance:distribution-manifest:v0",
  "title": "Governance distribution manifest V0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "distribution", "version", "files"],
  "properties": {
    "$schema": {
      "const": "urn:mayf3:agent-development-governance:distribution-manifest:v0"
    },
    "schema_version": {"const": 1},
    "distribution": {"const": "development-governance-v0"},
    "version": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.agents/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
